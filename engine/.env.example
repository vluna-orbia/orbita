# Órbita — motor de investigación. Copia este fichero a .env y rellena.

# URL de conexión a PostgreSQL, la misma base que el servicio web.
# En Railway: referencia al servicio Postgres con ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres@localhost:5432/orbita

# Zona horaria de los cálculos y del scheduler (encargo 6).
TZ=Europe/Madrid

# Puerto del servidor. Railway lo inyecta automáticamente.
# PORT=8000

# ANTHROPIC_API_KEY se añade con el encargo 6: clave dedicada al motor,
# aislada de la suscripción interactiva del usuario.
