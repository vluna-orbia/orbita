# Órbita — servicio web. Copia este fichero a .env y rellena los valores.

# URL de conexión a PostgreSQL. Prisma es el dueño del esquema.
# En local: la base creada para desarrollo.
# En Railway: referencia al servicio Postgres con ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres@localhost:5432/orbita

# Contraseña única de acceso a la aplicación. Un solo usuario, sin registro.
ORBITA_PASSWORD=elige-una-contrasena-larga

# Secreto con el que se firma la cookie de sesión (30 días). Genera 32 o
# más caracteres aleatorios, por ejemplo con: openssl rand -hex 32
AUTH_SECRET=genera-un-secreto-aleatorio-de-32-caracteres-o-mas

# Puerto del servidor. Railway lo inyecta automáticamente; en local es
# opcional (Next usa 3000 por defecto).
# PORT=3000
